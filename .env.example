# Copy to .env.local and supply a key to enable live AI answers.
# Never prefix these variables with NEXT_PUBLIC_.
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible provider override:
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=

# Set the real production origin before deployment (e.g. https://your-domain.com).
# Used for canonical URLs, social sharing, robots and sitemap.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically if this is empty.
SITE_URL=
